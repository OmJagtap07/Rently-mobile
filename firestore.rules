rules_version = '2';

// Rently 2.0 — Firestore Security Rules v1.1
//
// Source of truth:
// - schema.md v1.3
// - authorization.md v1.1
// - cloud-functions.md v1.1
//
// SECURITY MODEL
// 1. These rules protect DIRECT client access to Firestore.
// 2. Callable Cloud Functions authenticate/authorize the caller themselves.
// 3. Cloud Functions use the Admin SDK for trusted transactional writes.
// 4. Admin SDK/server libraries bypass Firestore Security Rules.
// 5. Any operation requiring consistency across multiple documents is
//    Cloud-Function-only.
//
// Firebase reference:
// https://firebase.google.com/docs/firestore/security/rules-conditions

service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────────────────── AUTH HELPERS ─────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return isSignedIn() ? request.auth.token.role : null;
    }

    function isLandlord() {
      return role() == 'landlord';
    }

    function isTenant() {
      return role() == 'tenant';
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Cross-document field allowlist convention.
    // Prevents callers from modifying protected identity/derived fields.
    function onlyChangedFields(allowed) {
      return request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasOnly(allowed);
    }

    function callerUser() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function callerActiveLease() {
      let user = callerUser();
      return user.activeLeaseId == null
        ? null
        : get(
            /databases/$(database)/documents/leases/$(user.activeLeaseId)
          ).data;
    }

    function isCallersProperty(propertyId) {
      let lease = callerActiveLease();
      return lease != null && lease.propertyId == propertyId;
    }

    function isCallersUnit(unitId) {
      let lease = callerActiveLease();
      return lease != null && lease.unitId == unitId;
    }

    function validRentChargeLineItemAmount(item) {
      return item.keys().hasOnly(['type', 'label', 'amount'])
             && item.type in ['rent', 'electricity', 'maintenance', 'other']
             && item.label.matches('.*[^\\s].*')
             && item.amount is int
             && item.amount >= 0
             ? item.amount
             : null;
    }

    function rentChargeLineItemsSubtotal(items) {
      return items is list && items.size() > 0 && items.size() <= 10
             ? validRentChargeLineItemAmount(items[0])
               + (items.size() > 1
                 ? validRentChargeLineItemAmount(items[1])
                 : 0)
               + (items.size() > 2
                 ? validRentChargeLineItemAmount(items[2])
                 : 0)
               + (items.size() > 3
                 ? validRentChargeLineItemAmount(items[3])
                 : 0)
               + (items.size() > 4
                 ? validRentChargeLineItemAmount(items[4])
                 : 0)
               + (items.size() > 5
                 ? validRentChargeLineItemAmount(items[5])
                 : 0)
               + (items.size() > 6
                 ? validRentChargeLineItemAmount(items[6])
                 : 0)
               + (items.size() > 7
                 ? validRentChargeLineItemAmount(items[7])
                 : 0)
               + (items.size() > 8
                 ? validRentChargeLineItemAmount(items[8])
                 : 0)
               + (items.size() > 9
                 ? validRentChargeLineItemAmount(items[9])
                 : 0)
             : null;
    }

    function rentChargeRentLineItemCount(items) {
      return (items[0].type == 'rent' ? 1 : 0)
             + (items.size() > 1 ? (items[1].type == 'rent' ? 1 : 0) : 0)
             + (items.size() > 2 ? (items[2].type == 'rent' ? 1 : 0) : 0)
             + (items.size() > 3 ? (items[3].type == 'rent' ? 1 : 0) : 0)
             + (items.size() > 4 ? (items[4].type == 'rent' ? 1 : 0) : 0)
             + (items.size() > 5 ? (items[5].type == 'rent' ? 1 : 0) : 0)
             + (items.size() > 6 ? (items[6].type == 'rent' ? 1 : 0) : 0)
             + (items.size() > 7 ? (items[7].type == 'rent' ? 1 : 0) : 0)
             + (items.size() > 8 ? (items[8].type == 'rent' ? 1 : 0) : 0)
             + (items.size() > 9 ? (items[9].type == 'rent' ? 1 : 0) : 0);
    }

    function isValidRentChargeDraftData(bill, rentChargeId) {
      return bill.keys().hasOnly([
                       'status',
                       'leaseId',
                       'landlordId',
                       'tenantId',
                       'propertyId',
                       'unitId',
                       'billingMonth',
                       'lineItems',
                       'subtotal',
                       'lateFineTotal',
                       'adjustmentTotal',
                       'total',
                       'dueDate',
                       'createdAt',
                       'updatedAt'
                     ])
                    && bill.status == 'draft'
                    && bill.landlordId == request.auth.uid
                    && bill.leaseId is string
                    && bill.tenantId is string
                    && bill.propertyId is string
                    && bill.unitId is string
                    && bill.billingMonth is string
                    && bill.billingMonth.matches(
                      '^(0[0-9]{3}|[1-9][0-9]{3})-(0[1-9]|1[0-2])$'
                    )
                    && rentChargeId == bill.leaseId + '_' + bill.billingMonth
                    && rentChargeRentLineItemCount(bill.lineItems) == 1
                    && bill.subtotal == rentChargeLineItemsSubtotal(bill.lineItems)
                    && bill.lateFineTotal == 0
                    && bill.adjustmentTotal == 0
                    && bill.total == bill.subtotal
                    && bill.dueDate == bill.billingMonth + '-10'
                    && bill.createdAt is timestamp
                    && bill.updatedAt is timestamp;
    }

    function rentChargeReferencesActiveLease(bill) {
      let lease = get(
        /databases/$(database)/documents/leases/$(bill.leaseId)
      ).data;
      let tenant = get(
        /databases/$(database)/documents/users/$(bill.tenantId)
      ).data;
      let property = get(
        /databases/$(database)/documents/properties/$(bill.propertyId)
      ).data;
      let unit = get(
        /databases/$(database)/documents/units/$(bill.unitId)
      ).data;

      return lease.status == 'active'
                    && lease.landlordId == request.auth.uid
                    && lease.tenantId == bill.tenantId
                    && lease.propertyId == bill.propertyId
                    && lease.unitId == bill.unitId
                    && tenant.role == 'tenant'
                    && tenant.activeLeaseId == bill.leaseId
                    && property.landlordId == request.auth.uid
                    && unit.landlordId == request.auth.uid
                    && unit.propertyId == bill.propertyId
                    && unit.status == 'occupied'
                    && unit.currentLeaseId == bill.leaseId;
    }

    function rentChargeLeaseIsActive(bill) {
      let lease = get(
        /databases/$(database)/documents/leases/$(bill.leaseId)
      ).data;
      return lease.status == 'active'
             && lease.landlordId == request.auth.uid
             && lease.tenantId == bill.tenantId
             && lease.propertyId == bill.propertyId
             && lease.unitId == bill.unitId;
    }

    function validRentChargeDraft(rentChargeId) {
      let bill = request.resource.data;
      return isValidRentChargeDraftData(bill, rentChargeId)
             && rentChargeReferencesActiveLease(bill);
    }

    // ───────────────────────── USERS ─────────────────────────
    // User document creation is completeOnboarding()-only.
    // Role and activeLeaseId are never directly client-writable.

    match /users/{userId} {
      allow read: if isSelf(userId);

      allow create: if false;

      allow update: if isSelf(userId)
                    && onlyChangedFields([
                      'fullName',
                      'phone',
                      'photoURL',
                      'updatedAt'
                    ]);

      allow delete: if false;
    }

    // ───────────────────────── PROPERTIES ─────────────────────────

    match /properties/{propertyId} {
      allow create: if isLandlord()
                    && request.resource.data.landlordId == request.auth.uid;

      allow read: if
        (isLandlord()
          && resource.data.landlordId == request.auth.uid)
        ||
        (isTenant()
          && isCallersProperty(propertyId));

      allow update: if isLandlord()
                    && resource.data.landlordId == request.auth.uid
                    && request.resource.data.landlordId
                       == resource.data.landlordId
                    && onlyChangedFields([
                      'name',
                      'address',
                      'googleMapsLink',
                      'status',
                      'lateFineConfig',
                      'updatedAt'
                    ]);

      allow delete: if false;
    }

    // ───────────────────────── UNITS ─────────────────────────
    // status/currentLeaseId are derived state and function-managed.

    match /units/{unitId} {
      allow create: if isLandlord()
                    && request.resource.data.landlordId
                       == request.auth.uid
                    && get(
                      /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
                    ).data.landlordId == request.auth.uid;

      allow read: if
        (isLandlord()
          && resource.data.landlordId == request.auth.uid)
        ||
        (isTenant()
          && isCallersUnit(unitId));

      allow update: if isLandlord()
                    && resource.data.landlordId == request.auth.uid
                    && onlyChangedFields([
                      'roomNumber',
                      'baseRent',
                      'updatedAt'
                    ]);

      allow delete: if false;
    }

    // ───────────────────────── JOIN REQUESTS ─────────────────────────
    // Creation and acceptance are Cloud-Function-only.
    // Landlord may directly reject a pending request.

    match /joinRequests/{requestId} {
      allow create: if false;

      allow read: if
        (isLandlord()
          && resource.data.landlordId == request.auth.uid)
        ||
        (isTenant()
          && resource.data.tenantId == request.auth.uid);

      allow update: if isLandlord()
                    && resource.data.landlordId == request.auth.uid
                    && resource.data.status == 'pending'
                    && request.resource.data.status == 'rejected'
                    && onlyChangedFields([
                      'status',
                      'respondedAt',
                      'respondedBy',
                      'updatedAt'
                    ]);

      allow delete: if false;
    }

    // ───────────────────────── LEASES ─────────────────────────
    // Creation and ending are Cloud-Function-only.
    // Only currentBaseRent is directly editable by the landlord.

    match /leases/{leaseId} {
      allow create: if false;

      allow read: if
        (isLandlord()
          && resource.data.landlordId == request.auth.uid)
        ||
        (isTenant()
          && resource.data.tenantId == request.auth.uid);

      allow update: if isLandlord()
                    && resource.data.landlordId == request.auth.uid
                    && resource.data.status == 'active'
                    && onlyChangedFields([
                      'currentBaseRent',
                      'updatedAt'
                    ])
                    && request.resource.data.currentBaseRent is int
                    && request.resource.data.currentBaseRent >= 0;

      allow delete: if false;
    }

    // ───────────────────────── RENT CHARGES ─────────────────────────

    match /rentCharges/{rentChargeId} {

      // A landlord may create only a valid draft belonging to one of
      // their own leases. The deterministic ID prevents duplicate
      // lease+month bills.
      allow create: if isLandlord()
                    && validRentChargeDraft(rentChargeId);

      allow read: if
        (isLandlord()
          && resource.data.landlordId == request.auth.uid)
        ||
        (isTenant()
          && resource.data.tenantId == request.auth.uid);

      // Direct client edits are restricted to draft editing only.
      // Finalization, fines, adjustments, payment state and rollups
      // are Cloud-Function-only.
      allow update: if isLandlord()
                    && resource.data.landlordId == request.auth.uid
                    && resource.data.status == 'draft'
                    && request.resource.data.status == 'draft'
                    && onlyChangedFields([
                      'lineItems',
                      'subtotal',
                      'total',
                      'updatedAt'
                    ])
                    && isValidRentChargeDraftData(
                      request.resource.data,
                      rentChargeId
                    )
                    && rentChargeLeaseIsActive(request.resource.data);

      allow delete: if false;

      // ───────────────────── FINE APPLICATIONS ─────────────────────

      match /fineApplications/{fineId} {
        allow create: if false;

        allow read: if
          (isLandlord()
            && get(
              /databases/$(database)/documents/rentCharges/$(rentChargeId)
            ).data.landlordId == request.auth.uid)
          ||
          (isTenant()
            && get(
              /databases/$(database)/documents/rentCharges/$(rentChargeId)
            ).data.tenantId == request.auth.uid);

        allow update, delete: if false;
      }

      // ───────────────────── ADJUSTMENTS ─────────────────────

      match /adjustments/{adjustmentId} {
        allow create: if false;

        allow read: if
          (isLandlord()
            && get(
              /databases/$(database)/documents/rentCharges/$(rentChargeId)
            ).data.landlordId == request.auth.uid)
          ||
          (isTenant()
            && get(
              /databases/$(database)/documents/rentCharges/$(rentChargeId)
            ).data.tenantId == request.auth.uid);

        allow update, delete: if false;
      }
    }

    // ───────────────────────── PAYMENTS ─────────────────────────
    //
    // Creation is Cloud-Function-only because payment creation must
    // atomically update the corresponding rentCharge to payment_pending.
    //
    // Verification is Cloud-Function-only because verification must
    // atomically update BOTH payment and rentCharge.
    //
    // This also prevents a tenant from creating a "verified" payment
    // or a landlord from manually verifying a gateway payment.

    match /payments/{paymentId} {
      allow create: if false;

      allow read: if
        (isLandlord()
          && resource.data.landlordId == request.auth.uid)
        ||
        (isTenant()
          && resource.data.tenantId == request.auth.uid);

      allow update, delete: if false;
    }

    // ───────────────────────── EXPENSES ─────────────────────────
    // Hard deletion is disabled. Archive through status: 'archived'.

    match /expenses/{expenseId} {
      allow create: if isLandlord()
                    && request.resource.data.landlordId
                       == request.auth.uid
                    && get(
                      /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
                    ).data.landlordId == request.auth.uid;

      allow read: if isLandlord()
                  && resource.data.landlordId == request.auth.uid;

      allow update: if isLandlord()
                    && resource.data.landlordId == request.auth.uid
                    && onlyChangedFields([
                      'category',
                      'description',
                      'amount',
                      'date',
                      'status',
                      'updatedAt'
                    ]);

      allow delete: if false;
    }

    // ───────────────────────── NOTIFICATIONS ─────────────────────────
    // Server-created only. User can only mark their own notification read.

    match /notifications/{notificationId} {
      allow create: if false;

      allow read: if isSelf(resource.data.recipientId);

      allow update: if isSelf(resource.data.recipientId)
                    && onlyChangedFields(['read']);

      allow delete: if false;
    }

    // ───────────────────────── DEFAULT DENY ─────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
